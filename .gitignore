# ─── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*.so
*.egg-info/
.venv/
dist/
build/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ─── Rust ────────────────────────────────────────
# Build output (matches target/ ANYWHERE in repo, e.g. mavis_core/target/)
target/
**/*.rs.bk

# ─── IDE / Editor ────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Environment & Secrets ───────────────────────
.env
.envrc

# ─── Data / Logs / Memory (keep .gitkeep) ───────
/data/*
/logs/*
/memory/*
!/data/.gitkeep
!/logs/.gitkeep
!/memory/.gitkeep

# ─── SQLite ──────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── OS ──────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Cargo.lock ──────────────────────────────────
# For a binary crate like mavis_core, Cargo recommends committing Cargo.lock
# for reproducible builds. Remove this line if you want it tracked.
Cargo.lock